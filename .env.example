# LinuxAid server-side AI proxy environment.
# NEVER place these secret values in config.js, HTML, client-side JS or GitHub Pages.

# Recommended default for LinuxAid's Linux tutor.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Optional alternative providers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# AI request timeout in milliseconds (5s minimum, 30s maximum in api/ai.js).
AI_TIMEOUT_MS=18000

# Comma-separated trusted browser origins for the API proxy.
LINUXAID_ALLOWED_ORIGIN=https://martechmods2.github.io

# Optional Firebase CLI/deployment project identifier.
FIREBASE_PROJECT_ID=
