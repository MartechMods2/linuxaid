# LinuxAid AI Edge Function environment. NEVER expose these values in browser JavaScript.
# Recommended hosted option: NVIDIA NIM free endpoint.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional fallback providers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# AI protection / cost controls.
LINUXAID_AI_DAILY_LIMIT=40
AI_UPSTREAM_TIMEOUT_MS=22000

# Comma-separated browser origins allowed to call the Edge Function.
LINUXAID_ALLOWED_ORIGINS=https://martechmods2.github.io,http://localhost:3000,http://127.0.0.1:3000

# Optional Firebase CLI/deployment project identifier (legacy only).
FIREBASE_PROJECT_ID=
