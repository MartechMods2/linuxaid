# Server-side AI proxy environment. Do not expose these values in browser JavaScript.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Restrict browser callers to the LinuxAid site in production.
LINUXAID_ALLOWED_ORIGIN=https://martechmods2.github.io

# Optional Firebase CLI/deployment project identifier.
FIREBASE_PROJECT_ID=
